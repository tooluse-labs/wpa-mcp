<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.7.1</Version>
    <!-- Constructed CLR type names appear in reviewed schema titles. Keep the
         0.x assembly binding identity stable so a package-only version bump
         does not churn canonical Contract 2.0 bytes and content addresses. -->
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.4.1.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>wpa-mcp</AssemblyTitle>
    <Product>wpa-mcp</Product>
    <Description>ETW trace analysis for MCP clients</Description>
    <ApplicationIcon>..\..\assets\wpa-mcp-avatar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WpaMcp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\eng\capabilities.v1.json" Link="eng\capabilities.v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\eng\tool-contracts.v2.json" Link="eng\tool-contracts.v2.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\eng\privacy-taxonomy.v1.json" Link="eng\privacy-taxonomy.v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\benchmarks\capability-matrix.v1.json" Link="benchmarks\capability-matrix.v1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>

    <!-- Embedded fallbacks keep reviewed manifests available to bundled/single-file hosts. -->
    <EmbeddedResource Include="..\..\eng\capabilities.v1.json"
                      LogicalName="WpaMcp.Manifests.eng.capabilities.v1.json" />
    <EmbeddedResource Include="..\..\eng\tool-contracts.v2.json"
                      LogicalName="WpaMcp.Manifests.eng.tool-contracts.v2.json" />
    <EmbeddedResource Include="..\..\eng\privacy-taxonomy.v1.json"
                      LogicalName="WpaMcp.Manifests.eng.privacy-taxonomy.v1.json" />
    <EmbeddedResource Include="..\..\benchmarks\capability-matrix.v1.json"
                      LogicalName="WpaMcp.Manifests.benchmarks.capability-matrix.v1.json" />
  </ItemGroup>

</Project>
