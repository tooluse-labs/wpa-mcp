<?xml version="1.0"?>
<WindowsPerformanceRecorder Version="1.0" Author="wpa-mcp">
  <Profiles>
    <SystemCollector Id="SC" Name="WpaMcpMemorySC">
      <BufferSize Value="1024"/>
      <Buffers Value="64"/>
    </SystemCollector>
    <SystemProvider Id="SP">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="Memory"/>
        <Keyword Value="MemoryInfo"/>
        <Keyword Value="MemoryInfoWS"/>
        <Keyword Value="Handle"/>
        <Keyword Value="Pool"/>
      </Keywords>
    </SystemProvider>
    <Profile Id="MemoryMcp.Verbose.File" Name="MemoryMcp" Description="Memory resource fixture capture"
             LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SC">
          <SystemProviderId Value="SP"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
