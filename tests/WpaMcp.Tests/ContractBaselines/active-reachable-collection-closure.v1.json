  "proofDefinitions": [
    {
      "proofMode": "manifest_pageable",
      "owner": "core-contracts",
      "sourceNote": "The exact tool/path is declared in eng/tool-contracts.v2.json pageableSections and its totals/truncation state are projected by ReviewedToolOutcomeAdapters. The test checks the manifest in both directions."
    },
    {
      "proofMode": "manifest_only",
      "owner": "core-contracts",
      "sourceNote": "Every currently reviewed occurrence of this property is manifest-pageable. This is not a fallback proof: any non-pageable reuse fails, and the classified occurrence hash prevents an unreviewed path from being added."
    },
    {
      "proofMode": "typed_nested_boundary",
      "owner": "output-contracts",
      "sourceNote": "A sibling or parent EmbeddedTopNBoundary carries requested/returned/total-state/more-state for the row-local collection; CompositeResultContractValidator or ReviewedToolOutcomeAdapters validates the producer-specific binding."
    },
    {
      "proofMode": "scope_identity_exact",
      "owner": "scope-contracts",
      "sourceNote": "Scope candidate/included identity arrays are complete resolution results. ToolEnvelopeProjection publishes exact candidate/included totals; ToolResponseFrameFitter only omits both detail arrays together with detailCompleteness=omitted_due_to_response_budget."
    },
    {
      "proofMode": "warnings_exhaustive",
      "owner": "outcome-contracts",
      "sourceNote": "Reviewed producers append the complete warning set for the result. ToolResponseFrameFitter never silently trims warnings; an oversized non-cursor result fails atomically."
    },
    {
      "proofMode": "fixed_catalog_exhaustive",
      "owner": "capability-and-composite-contracts",
      "sourceNote": "The collection enumerates a finite reviewed capability/workflow/evidence/planner domain or a fixed composite call/evidence plan. Producers emit the complete applicable set rather than a data-dependent top/sample prefix."
    },
    {
      "proofMode": "producer_exhaustive",
      "owner": "analyzer-owners",
      "sourceNote": "Producer review confirmed complete accumulator/payload enumeration with no Take/TakeLast/sample cap on this non-pageable occurrence. Any new occurrence changes the classified occurrence hash and must be reviewed."
    }
  ],
