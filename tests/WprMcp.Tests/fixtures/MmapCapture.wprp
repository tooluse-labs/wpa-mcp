<?xml version="1.0"?>
<WindowsPerformanceRecorder Version="1.0" Author="wpa-mcp">
  <Profiles>
    <SystemCollector Id="SC" Name="WpaMcpSC">
      <BufferSize Value="256"/>
      <Buffers Value="8"/>
    </SystemCollector>
    <SystemProvider Id="SP">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="HardFaults"/>
        <Keyword Value="MemoryInfo"/>
      </Keywords>
    </SystemProvider>
    <Profile Id="MmapMcp.Verbose.File" Name="MmapMcp" Description="Mmap fixture capture"
             LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SC">
          <SystemProviderId Value="SP"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
