<?xml version="1.0"?>
<WindowsPerformanceRecorder Version="1.0" Author="wpa-mcp">
  <Profiles>
    <SystemCollector Id="SC" Name="WpaMcpWaitBoundSC">
      <BufferSize Value="256"/>
      <Buffers Value="16"/>
    </SystemCollector>
    <SystemProvider Id="SP">
      <Keywords>
        <Keyword Value="ProcessThread"/>
        <Keyword Value="Loader"/>
        <Keyword Value="CSwitch"/>
        <Keyword Value="ReadyThread"/>
      </Keywords>
      <Stacks>
        <Stack Value="ThreadCreate"/>
        <Stack Value="CSwitch"/>
        <Stack Value="ReadyThread"/>
      </Stacks>
    </SystemProvider>
    <Profile Id="WaitBoundMcp.Verbose.File" Name="WaitBoundMcp" Description="Wait-bound fixture capture"
             LoggingMode="File" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SC">
          <SystemProviderId Value="SP"/>
        </SystemCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
