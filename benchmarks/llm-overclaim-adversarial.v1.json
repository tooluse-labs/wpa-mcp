{
  "schemaVersion": "llm-overclaim-adversarial.v1",
  "suiteVersion": "1.0.0",
  "evaluationKind": "deterministic_contract_proxy",
  "modelExecution": "none",
  "claimScope": "Offline deterministic checks of whether the active catalog and public output contract expose blockers for fixed overclaim risks. This is not a named-model quality evaluation.",
  "scoringContract": {
    "metricDefinitions": {
      "wrongToolProxyRate": "Scenarios whose declared route references an inactive tool, omits an evidence-provider tool, or exceeds the frozen two-call route budget, divided by all scenarios.",
      "overclaimProxyRate": "Forbidden conclusions for which at least one declared structured blocker is absent from the active contract, divided by all forbidden conclusions.",
      "missingCaveatProxyRate": "Required caveats for which at least one declared structured evidence requirement is absent, divided by all required caveats.",
      "meanDeclaredRouteCallsProxy": "Arithmetic mean of declared route tool counts. This is static route complexity, not observed model tool calls."
    },
    "thresholds": {
      "maximumWrongToolProxyRate": 0.0,
      "maximumOverclaimProxyRate": 0.0,
      "maximumMissingCaveatProxyRate": 0.0,
      "maximumMeanDeclaredRouteCallsProxy": 2.0
    }
  },
